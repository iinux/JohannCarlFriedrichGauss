./libp2p-server \
    -listen /ip4/0.0.0.0/tcp/4001 \
    -announce /dns4/hw.iinux.cn/tcp/4001


client1 指定目标服务，例如转发到本机 SSH：

  ./libp2p-client \
    -relay /dns4/hw.iinux.cn/tcp/4001/p2p/12D3KooWATfGciDLRHHrXsdZvZbZkuFDroidXZT4qMjcWNWL7dZp \
    -code 1234 \
    -target-ip 127.0.0.1 \
    -target-port 22

  client2 开放本地端口：

  ./libp2p-client \
    -relay /dns4/hw.iinux.cn/tcp/4001/p2p/12D3KooWATfGciDLRHHrXsdZvZbZkuFDroidXZT4qMjcWNWL7dZp \
    -code 1234 \
    -listen-ip 127.0.0.1 \
    -listen-port 6000


