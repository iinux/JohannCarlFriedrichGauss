wget https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.1.5.tar.xz

make tinyconfig
make menuconfig
make -j 4

sudo dnf config-manager --set-enabled crb
sudo yum install epel-release -y
sudo yum install qemu-kvm syslinux genisoimage glibc-static glibc-devel -y
/usr/libexec/qemu-kvm -kernel arch/x86/boot/bzImage

gcc -c shell.c
as sys.S
ld -o shell shell.o a.out --entry main -z noexecstack

mv shell init
echo init | cpio -H newc -o > init.cpio

make isoimage FDARGS="initrd=/init.cpio" FDINITRD=shell/init.cpio

wget https://www. lua.org/ftp/lua-5.4.7.tar.gz
tar xzf lua-5.4.7.tar.gz
cd lua-5.4.7/src/
vi Makefile
# MYLDFLAGS=-static
make

cp lua-5.4.7/src/lua .
echo init >> files
echo lua >> files
cat files | cpio -H newc -o > init.cpio

qemu-kvm -cpu max -cdrom arch/x86/boot/image.iso

qemu-kvm -kernel arch/x86/boot/bzImage -initrd ~/git/JohannCarlFriedrichGauss/c/mytinylinux/init.cpio -s -S
# 另一个终端
  gdb vmlinux
  (gdb) target remote :1234
  (gdb) break do_execveat_common
  (gdb) continue

nm vmlinux | grep do_execve

scripts/config --set-val CONFIG_DEBUG_INFO_DWARF4 y
scripts/config --set-val CONFIG_DEBUG_INFO_NONE n
grep DEBUG_INFO .config   # 确认结果
make olddefconfig          # 补全依赖项
make -j$(nproc)

验证是否真的生成了 DWARF 信息(编译完之后):
readelf -S vmlinux | grep debug
如果能看到 .debug_info、.debug_line 这些 section,说明调试信息成功生成了,这时候 GDB 加载就不会再提示 "No debugging symbols found"。
